#!/bin/sh
set -eu

NODE_VERSION=22.22.0
DARWIN_ARM64_FILE=node-v22.22.0-darwin-arm64.tar.gz
DARWIN_ARM64_SHA256=5ed4db0fcf1eaf84d91ad12462631d73bf4576c1377e192d222e48026a902640
LINUX_X64_FILE=node-v22.22.0-linux-x64.tar.gz
LINUX_X64_SHA256=c33c39ed9c80deddde77c960d00119918b9e352426fd604ba41638d6526a4744
BASE_URL=https://nodejs.org/dist/v22.22.0

die() {
  echo "codex-setup bootstrap: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is unavailable: $1"
}

case ${HOME-} in
  /*) ;;
  *) die "HOME must be an absolute path" ;;
esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)

case ${CODEX_SETUP_DATA_HOME-} in
  /*) DATA_ROOT=$CODEX_SETUP_DATA_HOME ;;
  "")
    case ${XDG_DATA_HOME-} in
      /*) DATA_ROOT=$XDG_DATA_HOME/codex-setup ;;
      "") DATA_ROOT=$HOME/.local/share/codex-setup ;;
      *) die "XDG_DATA_HOME must be absolute when set" ;;
    esac
    ;;
  *) die "CODEX_SETUP_DATA_HOME must be absolute when set" ;;
esac

SYSTEM=$(uname -s)
MACHINE=$(uname -m)
case "$SYSTEM/$MACHINE" in
  Darwin/arm64)
    PLATFORM=darwin-arm64
    ARCHIVE_FILE=$DARWIN_ARM64_FILE
    EXPECTED_SHA256=$DARWIN_ARM64_SHA256
    ;;
  Linux/x86_64|Linux/amd64)
    PLATFORM=linux-x64
    ARCHIVE_FILE=$LINUX_X64_FILE
    EXPECTED_SHA256=$LINUX_X64_SHA256
    ;;
  *) die "unsupported bootstrap platform: $SYSTEM/$MACHINE" ;;
esac

require_command curl
require_command tar
require_command mktemp

if command -v sha256sum >/dev/null 2>&1; then
  CHECKSUM_COMMAND=sha256sum
elif command -v shasum >/dev/null 2>&1; then
  CHECKSUM_COMMAND=shasum
else
  die "sha256sum or shasum is required"
fi

TEMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/codex-setup-bootstrap.XXXXXX")
ARCHIVE=$TEMP_ROOT/$ARCHIVE_FILE
LISTING=$TEMP_ROOT/archive.list
TRANSIENT_NODE=$TEMP_ROOT/node

cleanup() {
  status=$?
  case "$TEMP_ROOT" in
    "${TMPDIR:-/tmp}"/codex-setup-bootstrap.*) rm -rf -- "$TEMP_ROOT" 2>/dev/null || true ;;
  esac
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

echo "Downloading pinned bootstrap Node.js $NODE_VERSION for $PLATFORM..."
curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
  --output "$ARCHIVE" "$BASE_URL/$ARCHIVE_FILE"

if [ "$CHECKSUM_COMMAND" = sha256sum ]; then
  ACTUAL_SHA256=$(sha256sum "$ARCHIVE" | awk '{print $1}')
else
  ACTUAL_SHA256=$(shasum -a 256 "$ARCHIVE" | awk '{print $1}')
fi
[ "$ACTUAL_SHA256" = "$EXPECTED_SHA256" ] || die "Node.js archive checksum mismatch"

tar -tzf "$ARCHIVE" > "$LISTING"
while IFS= read -r member; do
  case "$member" in
    /*|../*|*/../*|*\\*) die "unsafe Node.js archive member: $member" ;;
  esac
done < "$LISTING"

mkdir -- "$TRANSIENT_NODE"
tar -xzf "$ARCHIVE" --strip-components=1 -C "$TRANSIENT_NODE"
[ -x "$TRANSIENT_NODE/bin/node" ] || die "verified Node.js archive did not contain node/bin/node"

echo "Pinned transient runtime verified; installing or reconciling the complete locked toolchain..."
CODEX_SETUP_NODE="$TRANSIENT_NODE/bin/node" CODEX_SETUP_DATA_HOME="$DATA_ROOT" \
  "$REPO_ROOT/bin/codex-setup" install-toolchain "$@"

echo "codex-setup bootstrap complete."
